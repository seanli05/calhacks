# Copy to .env and fill in. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_DEFAULT=claude-sonnet-5-5
MODEL_DEEP=claude-opus-5-5

# Cartesia
CARTESIA_API_KEY=
# The phone agent's voice on calls: any Cartesia voice ID (Pipecat has no default).
CARTESIA_AGENT_VOICE_ID=
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_TTS_MODEL=sonic-3.6

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_AGENT_NUMBER=
# The mock agency line (demo only). The seed uses it as the verified official number.
TWILIO_MOCK_AGENCY_NUMBER=+15672298566
# The code shown on Twilio's WhatsApp sandbox page, without "join" (e.g. purple-tiger).
TWILIO_SANDBOX_JOIN_CODE=

# Database: the team's shared Neon Postgres (ask person 1 for the URL).
# Paste Neon's URLs as-is; settings.py rewrites them for asyncpg.
# The unpooled one is used when set.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional: a separate Neon branch for DB tests (they drop every table). Never the shared one.
TEST_DATABASE_URL=

# Public URL from ngrok, used for Twilio webhooks
PUBLIC_BASE_URL=

# Dev-only endpoints under /dev (e.g. POST /dev/fake-call). Local requests only; keep false for the demo.
DEV_ENDPOINTS=false

# Demo only (Plan.md C40): the phone agent dials this instead of the verified
# official number, so rehearsals never call a real agency. Clear it to call real agencies.
DEMO_DIAL_NUMBER=+15672298566

# Run the research agent's job worker inside the backend (needs ANTHROPIC_API_KEY).
# Set false when a local backend points at the shared database: only the deployed one claims jobs there.
RESEARCH_WORKER=true

# Run the memory writer's job worker inside the backend (needs ANTHROPIC_API_KEY).
# Same rule: false when a local backend points at the shared database.
MEMORY_WORKER=true

# Phone smoke test only (`python -m app.phone.smoke --own-number`): your own phone,
# E.164, to play the agency yourself. Keep it in your .env; never commit a real one.
PHONE_SMOKE_DIAL_NUMBER=
# Phone smoke test only (`--bridge`): your own phone, E.164, rung as the applicant
# when a person answers. Keep it in your .env; never commit a real one.
PHONE_SMOKE_USER_NUMBER=
