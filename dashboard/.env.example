# Copy to .env.local in this folder. Never commit .env.local.

# live (default): call the FastAPI routes through the /api rewrite.
# fixtures: fake data from lib/api/fixtures.ts, no backend needed.
NEXT_PUBLIC_DATA=live

# Where the /api rewrite sends requests (the FastAPI app).
BACKEND_URL=http://localhost:8000

# The landing page's "Already have a dashboard?": "Label:user_id" per demo account,
# comma-separated. The IDs survive `app.db.reset --keep-users`. Empty hides the link.
NEXT_PUBLIC_DEMO_USERS=
