# Copy to .env.local in this folder. Never commit .env.local.

# live (default): call the FastAPI routes through the /api rewrite.
# fixtures: fake data from lib/api/fixtures.ts, no backend needed.
NEXT_PUBLIC_DATA=live

# Where the /api rewrite sends requests (the FastAPI app).
BACKEND_URL=http://localhost:8000

# The landing page's "Already have a dashboard?": each demo account's user ID (user_...)
# or full dashboard URL. The IDs survive `app.db.reset --keep-users`. Unset hides that
# account; both unset hides the menu. Restart the dashboard after changing these.
NEXT_PUBLIC_MARIAM_HOST_DASHBOARD=
NEXT_PUBLIC_ANA_HOST_DASHBOARD=
